{
  "friendly_name": "Calibre",
  "image_src": "calibre.png",
  "description": "Calibre is a powerful and easy to use e-book manager.",
  "cores": 2,
  "memory": 2768,
  "gpu_count": 0,
  "cpu_allocation_method": "Inherit",
  "docker_registry": "https://ghcr.io/",
  "categories": [
    "Multimedia"
  ],
  "require_gpu": false,
  "enabled": true,
  "image_type": "Container",
  "run_config": {
    "security_opt": [
      "seccomp=unconfined"
    ],
    "entrypoint": [
      "/kasminit"
    ],
    "user": 1000,
    "environment": {
      "HOME": "/home/kasm-user"
    }
  },
  "exec_config": {},
  "architecture": [
    "amd64",
    "arm64"
  ],
  "compatibility": [
    {
      "version": "1.13.x",
      "image": "lscr.io/linuxserver/calibre:latest",
      "uncompressed_size_mb": 1950
    },
    {
      "version": "1.14.x",
      "image": "lscr.io/linuxserver/calibre:latest",
      "uncompressed_size_mb": 1950
    },
    {
      "version": "1.15.x",
      "image": "lscr.io/linuxserver/calibre:latest",
      "uncompressed_size_mb": 1950
    },
    {
      "version": "1.16.x",
      "image": "lscr.io/linuxserver/calibre:latest",
      "uncompressed_size_mb": 1950
    }
  ]
}